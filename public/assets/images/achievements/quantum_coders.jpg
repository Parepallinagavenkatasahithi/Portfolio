<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 625" width="1000" height="625">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FAF8F5" />
      <stop offset="50%" stop-color="#F2EDE6" />
      <stop offset="100%" stop-color="#E7DFD4" />
    </linearGradient>
    <pattern id="grid" width="32" height="32" patternUnits="userSpaceOnUse">
      <circle cx="16" cy="16" r="1" fill="#111111" opacity="0.08" />
    </pattern>
  </defs>

  <!-- Background -->
  <rect width="100%" height="100%" fill="url(#bgGrad)" />
  <rect width="100%" height="100%" fill="url(#grid)" />

  <!-- Borders -->
  <rect x="20" y="20" width="960" height="585" fill="none" stroke="#D5CCC0" stroke-width="2" rx="16" />
  <rect x="32" y="32" width="936" height="561" fill="none" stroke="#2D4A3E" stroke-opacity="0.25" stroke-dasharray="6 6" rx="12" />

  <!-- Content Centered -->
  <g transform="translate(500, 312.5)">
    <!-- Icon Circle -->
    <circle cx="0" cy="-60" r="48" fill="#FFFFFF" stroke="#D5CCC0" stroke-width="2" />
    <text x="0" y="-45" font-size="36" text-anchor="middle">👥</text>

    <!-- Tag -->
    <rect x="-120" y="8" width="240" height="28" rx="14" fill="#2D4A3E" />
    <text x="0" y="26" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="11" font-weight="700" fill="#FAF8F5" text-anchor="middle" letter-spacing="2">TEAM LEADERSHIP</text>

    <!-- Title -->
    <text x="0" y="70" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="28" font-weight="800" fill="#111111" text-anchor="middle" letter-spacing="-0.5">Quantum Coders</text>

    <!-- Subtitle -->
    <text x="0" y="98" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="14" font-weight="500" fill="#4A4A4F" text-anchor="middle">Team Leadership • Algorithmic Sprint</text>

    <!-- Helper instruction -->
    <text x="0" y="140" font-family="'JetBrains Mono', monospace" font-size="11" fill="#6D6D75" text-anchor="middle">Replace with your real image in portfolio.ts</text>
  </g>
</svg>